{
  "name": "stellaire-solutions",
  "productName": "Stellaire Solutions",
  "version": "2.0.0",
  "description": "Suite d'outils de génération de documents de chantier (DPM, Formulaire DPM, TakeOff, rapports d'inspection).",
  "main": "electron/main.js",
  "type": "module",
  "author": "Isaac",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:e2e": "electron test/e2e/smoke.js",
    "test:all": "npm test && npm run test:e2e",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "node-xlsx": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.stellaire.solutions",
    "productName": "Stellaire Solutions",
    "artifactName": "Stellaire-Solutions-${version}.${ext}",
    "asar": false,
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "generators/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    }
  }
}
