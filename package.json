{
  "name": "stellaire-solutions",
  "productName": "Stellaire Solutions",
  "version": "1.0.1-alpha.3",
  "description": "Stellaire Solutions",
  "main": "electron/main.js",
  "type": "module",
  "author": "Isaac",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:e2e": "electron test/e2e/smoke.js",
    "test:all": "npm test && npm run test:e2e",
    "dist": "electron-builder --win --publish never",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-xlsx": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.consstellaire.stellaire-solutions",
    "productName": "Stellaire Solutions",
    "artifactName": "Stellaire Solutions-Setup-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "IsaacLaquerre",
      "repo": "stellaire-solutions",
      "private": false,
      "releaseType": "prerelease"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "core/**/*",
      "generators/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "icon": "assets/icon.ico",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}
